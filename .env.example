# .env.example — 설정 "키 이름"만 적은 예시 (PRD S-09-6, ARCHITECTURE 3장)
#
# ┌─ 실제 설정 파일의 위치 ──────────────────────────────────────────────────┐
# │  저장소 루트 .env      소유 changkwon:tbox-php, 권한 0640 (public/ 밖)   │
# └─────────────────────────────────────────────────────────────────────────┘
# 실제 설정은 저장소 루트 `.env` 한 곳에 둔다. public/ 밖이라 URL 로 보이지 않고,
# `.gitignore` 의 `.env` 줄로 Git 에는 들어가지 않는다 — 커밋되는 것은 이 `.env.example` 뿐이다.
#
# 소유가 changkwon 이고 그룹 tbox-php 0640 이므로 앱 계정(tbox-php)은 그룹으로 **읽기만** 한다 —
# 앱이 스스로 자기 설정을 고쳐 쓸 수 없다. 파일은 deploy/install.sh 가 만들고 소유·권한을 매번 맞춘다.
#   보기:   cat .env        (앱 그룹 밖이면 sudo)
#   고치기: nano .env       → sudo systemctl reload php8.1-fpm
# (운영 전환 시 /etc/tbox-v2/tbox.env(root:tbox-php)로 이전 검토 — 심층 방어. PRD S-09-6)
#
# 이 파일에는 비밀 값을 쓰지 않는다. 기본값이 안전한 숫자·경로만 예시로 남긴다.

# ─── PostgreSQL 접속 (ARCH 10장: 앱은 tbox_app 계정만 쓴다) ───
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
# tbox_app 의 비밀번호. install.sh 가 무작위로 만들어 /etc/tbox-v2/tbox.env 에만 넣는다.
DB_PASS=

# ─── 권한 매트릭스 편집 전용 DB 계정 (17-2, PRD F-25 ⑤, ARCHITECTURE 5.15 · 10장) ───
# `permissions` 표(역할 × 등급 16행)를 바꾸는 것은 곧 **보안 정책을 바꾸는 것**이다.
# 그래서 그 쓰기 자격을 앱 런타임 계정(DB_USER, 위)에 주지 않고 **별도 롤**로 갈라 둔다:
#   · tbox_app  → permissions 에 SELECT 만 (그대로. 다른 핸들러의 결함으로는 표를 못 바꾼다)
#   · tbox_perm → permissions 에 SELECT·UPDATE 만, 다른 표 권한 0, INSERT·DELETE 없음(16행 고정)
# 이 자격으로 여는 두 번째 연결(Db::perm)은 `PATCH /api/admin/permissions` 핸들러 **하나**에서만
# 만들어진다(린트가 그 밖의 사용을 반려한다). 두 키가 없으면 그 요청만 500 이고 나머지는 정상이다.
# 값은 deploy/install.sh 가 무작위로 만들어 .env 에 넣는다 — 이 예시 파일에는 비워 둔다.
DB_PERM_USER=
DB_PERM_PASS=

# ─── CSRF 토큰 HMAC 키 (PRD S-09-3, ARCHITECTURE 4.0) ───
# CSRF 토큰은 저장하지 않고 hash_hmac('sha256', 'csrf:'||세션해시, APP_SECRET) 으로 계산한다.
# 64자 hex(32바이트). deploy/install.sh 가 openssl rand -hex 32 로 만들어 /etc/tbox-v2/tbox.env 에만 넣는다.
# 이 값이 바뀌면 살아 있는 모든 세션의 CSRF 토큰이 무효가 된다(재로그인 필요).
APP_SECRET=

# ─── 세션 만료 (PRD S-09-2) ───
# 유휴 시간(분) — 이 시간 동안 요청이 없으면 세션 무효
SESSION_IDLE_MIN=30
# 절대 만료(시간) — 로그인 후 이 시간이 지나면 활동 중이어도 무효
SESSION_MAX_HOURS=8

# ─── 파일·로그 위치 (모두 웹 루트 밖. ARCH 3장) ───
# 업로드 원본이 저장되는 디렉터리 (0750 tbox-php)
STORAGE_DIR=/var/lib/tbox-v2/storage
# 감사 로그 파일 사본 (DB audit_logs 와 이중 기록. ARCH 7.1)
AUDIT_LOG_FILE=/var/log/tbox-v2/audit.log

# ─── F-14 "URL 로 파일 가져오기" 허용 호스트 (PRD S-05, Q-10) ───
# 쉼표로 구분한 호스트 이름 목록. 빈 값이면 기능이 전부 거부된다(기본 거부).
# 7단계에서 사용. 값이 비어 있어도 키 자체는 있어야 한다.
FETCH_ALLOWED_HOSTS=

# ─── 경보 알림 채널 (PRD S-11-A, ARCHITECTURE 11.4 · 9단계) ───
# scripts/alerts.php 가 규칙(AL-1·AL-2·AL-5·AL-7·AL-10·AL-12)에 걸린 일을 찾으면
#   ① /var/log/tbox-v2/alerts.log 에 한 줄 JSON
#   ② audit_logs 에 `alert.raised allow` (근거는 detail.rule·detail.evidence)
# 두 곳에 남긴다. 메일·메신저로 **보내지는 않는다** — 이 VM 에는 MTA 도 알림 채널도 없다.
#
# 이 키는 운영 전환 때 알림 명령(예: 사내 메신저 웹훅을 호출하는 사내 도구)을 적을 자리다.
# ★ 현재 구현은 값이 채워져 있어도 **실행하지 않고**, 경보 줄의 dispatch 를
#   "configured_not_sent" 로 적기만 한다. 설정 파일의 값이 곧 실행되는 명령이 되는 경로
#   (shell_exec·proc_open 류)를 앱 코드에 만들지 않기 위한 결정이다 (PRD S-09, 보안 린트 금지 패턴).
#   실제 전송을 붙이려면 별도 검토가 필요하다 — 그때 이 주석을 함께 고친다.
# 비어 있어도 되고, 키 자체가 없어도 된다(없으면 빈 값으로 본다).
ALERT_COMMAND=

# ─── F-54 악성코드 검사 (PRD F-54, ARCHITECTURE 5.28, SECURITY R-02 · R-86) ───
# 1 이면 새로 올라온 파일이 `scan_status='pending'` 으로 저장되고, 1분마다 도는
# scripts/scan_pending.php 가 clamscan 으로 검사해 clean/infected 로 바꾼다. 검사 전·격리 파일은
# 다운로드·미리보기·공유 링크가 403 이다. 값이 없거나 1 이 아니면 지금까지처럼 바로 clean 이다.
SCAN_ENABLED=

# ─── 앱 외부 주소 (쿠키 도메인·링크 생성용) ───
APP_URL=

# ─── F-49 프로그램용 업로드 API (PRD F-49, ARCHITECTURE 4.2, SECURITY R-82) ───
# ★ F-59(2026-09-16) → F-66(2026-09-22): 개인 토큰이 기본이다. **본인이** 「내 계정」 화면에서
#   비밀번호 + 2단계 코드로 발급하고(관리자는 목록·회수만), 감사 로그에 「누가·어느 토큰으로·
#   어느 범위로」가 사람 단위로 남는다.
#   아래 두 줄은 **이행용**이다 — 프로그램에 개인 토큰을 심었으면 두 줄을 지운다
#   (그러면 공용 경로가 닫히고 R-82 가 닫힌다). 삭제 창구 둘(`DELETE /api/files/{id}`·
#   `DELETE /api/folders/{num}`)은 공용 토큰으로는 애초에 쓸 수 없다(403).
#   ★ 공용 토큰에는 **범위도 만료도 없다**(개인 토큰은 범위 셋 중 하나 · 180일) — 서버가
#     `read+upload` 로 보며, 그래서 이행용이다. 범위·만료를 쓰려면 개인 토큰으로 옮긴다.
# 로컬 PC 의 프로그램이 2단계 인증 없이 `POST /api/upload` 로 파일을 올릴 때 쓰는 정적 토큰.
#
# API_TOKEN        무작위 **32자 이상**(권장 48자). 만들기·바꾸기는 scripts/api_token_rotate.sh.
#                  값이 없거나 32자 미만이면 `/api/upload` 는 전부 503 이다(닫힌 실패) —
#                  설정이 안 된 서버는 "아무나 올리는 서버" 가 아니라 "아무도 못 올리는 서버" 다.
#                  이 토큰이 통하는 곳은 `POST /api/upload` **하나뿐**이고, 다른 창구는
#                  `X-API-Token` 헤더를 읽지도 않는다. 사람의 2단계 인증을 대체하지 않는다.
#                  ★ 값은 이 서버의 .env 에만 둔다 — 저장소·문서·채팅에 적지 않는다(S-09-11).
# API_TOKEN_USER   업로드가 귀속될 계정 아이디. 그 계정이 올린 것으로 저장(files.uploaded_by)·
#                  감사되고, 인가와 등급 권한(decideUploadAs)도 그 계정 기준으로 판정된다.
#                  활성 계정이어야 하고 최초 로그인 강제 절차가 끝나 있어야 한다
#                  (아니면 `/api/upload` 는 503 — 요청이 아니라 서버 설정 문제다).
API_TOKEN=
API_TOKEN_USER=

# 커뮤니티 GPT 메신저 (선택). 키는 서버 .env 에만 저장; 1일 때만 외부 전송.
COMMUNITY_GPT_ENABLED=0
OPENAI_API_KEY=
COMMUNITY_GPT_MODEL=gpt-4.1-mini
