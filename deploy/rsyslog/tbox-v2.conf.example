# deploy/rsyslog/tbox-v2.conf.example
#
# 감사 로그를 **원격 로그 서버로 실시간 전송**하는 예시 설정
#   PRD 7.10 S-10-E "로그 감시: 감사 로그·서버 로그는 원격 로그 서버(추가 전용)로 실시간 전송"
#   ARCHITECTURE 11.4 (감시와 경보 그림) · 7.1 표 "서버가 털려도 남게"
#   SECURITY R-11 (감사 로그 원본이 같은 서버에 있으면 root 를 잃는 순간 증거도 잃는다)
#
# ★ 이 파일은 **적용되어 있지 않다.** 보낼 **대상 서버가 없기 때문**이다. 없는 주소로 보내는
#   설정을 켜면 rsyslog 가 계속 재시도하며 큐를 쌓고, "보내고 있다" 는 착각만 남는다.
#   그 착각이 진짜 사고 때 가장 비싸다.
#
#   그동안의 대체 수단 (9단계에서 실제로 한 것)
#     · `chattr +a /var/log/tbox-v2/audit.log` — 앱도 덧붙이기만 가능 (deploy/install.sh)
#     · `scripts/audit_chain.php` — 일별 sha256 해시 체인. 한 줄만 지워도 그날 값이 달라진다
#   둘 다 **root 를 잃으면 무력하다.** 그래서 원격 사본이 필요하고, 이 파일이 그 자리다.
#
# ── 적용 방법 (로그 서버가 생기면) ───────────────────────────
#   0. 로그 서버 쪽 준비: TLS 인증서(CA·서버), 이 호스트용 클라이언트 인증서,
#      수신 측 저장소는 **추가 전용**(append-only)으로. 보관 1년 (PRD S-07).
#   1. 인증서를 둔다:  sudo install -d -m 0700 -o root -g root /etc/rsyslog.d/certs
#   2. 이 파일을 복사하고 LOGHOST·인증서 경로를 고친다:
#        sudo install -o root -g root -m 0644 \
#          deploy/rsyslog/tbox-v2.conf.example /etc/rsyslog.d/40-tbox-v2.conf
#   3. 문법 검사 →  sudo rsyslogd -N1
#   4. 적용     →  sudo systemctl restart rsyslog
#   5. 확인     →  로그 서버에서 줄 수를 대조한다 (ARCH 7.1 표 "원격에서 줄 수 대조")
#                  끊기면 AL-8 "원격 로그 전송 중단" 에 해당한다 (PRD 7.11)
#   6. 방화벽: 아웃바운드 기본 거부이므로 로그 서버 IP:6514 를 허용해야 한다 (deploy/hardening.sh)

# ── 1) TLS (RFC 5425 syslog over TLS) ────────────────────────
global(
  DefaultNetstreamDriver="gtls"
  DefaultNetstreamDriverCAFile="/etc/rsyslog.d/certs/ca.pem"
  DefaultNetstreamDriverCertFile="/etc/rsyslog.d/certs/tbox-v2-cert.pem"
  DefaultNetstreamDriverKeyFile="/etc/rsyslog.d/certs/tbox-v2-key.pem"
)

# ── 2) 파일을 따라 읽는다 (imfile) ───────────────────────────
# audit.log 는 한 줄 JSON 이라 파싱이 쉽다 (ARCH 11.4 메모).
# `reopenOnTruncate` 는 logrotate 가 파일을 갈아 끼울 때 새 파일을 다시 잡게 한다.
module(load="imfile" mode="inotify")

input(type="imfile"
      File="/var/log/tbox-v2/audit.log"
      Tag="tbox-audit"
      Severity="info"
      Facility="local5"
      reopenOnTruncate="on"
      PersistStateInterval="1")

input(type="imfile"
      File="/var/log/tbox-v2/alerts.log"
      Tag="tbox-alerts"
      Severity="warning"
      Facility="local5"
      reopenOnTruncate="on"
      PersistStateInterval="1")

# ── 3) 전송 (큐를 디스크에 두어 끊겨도 잃지 않는다) ──────────
# 네트워크가 끊긴 동안 메모리에만 쌓으면 재부팅 때 사라진다 → LinkedList + 디스크 보조 큐.
# action.resumeRetryCount="-1" : 성공할 때까지 무한 재시도.
if ($syslogtag == "tbox-audit" or $syslogtag == "tbox-alerts") then {
  action(type="omfwd"
         target="LOGHOST.example.internal"      # ← 실제 로그 서버 주소로 바꾼다
         port="6514"
         protocol="tcp"
         StreamDriver="gtls"
         StreamDriverMode="1"                   # TLS 전용
         StreamDriverAuthMode="x509/name"       # 서버 인증서의 이름까지 확인한다
         StreamDriverPermittedPeers="LOGHOST.example.internal"
         queue.type="LinkedList"
         queue.filename="tbox_fwd"
         queue.maxDiskSpace="200m"
         queue.saveOnShutdown="on"
         action.resumeRetryCount="-1")
  stop
}

# ── 4) sshd·sudo 도 함께 보낸다 (PRD S-10-A "관리 접속 기록") ──
# 필요하면 아래 주석을 풀고 같은 action 블록을 auth,authpriv 에 붙인다.
# auth,authpriv.*  action(type="omfwd" target="LOGHOST.example.internal" port="6514" ... )
